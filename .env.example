# Optional: URL of your desktop companion server (defaults to http://127.0.0.1:4850)
NEXT_PUBLIC_COMPANION_URL=http://127.0.0.1:4850

# Optional: PostgreSQL connection string (only if you connect a database)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ─── Cloud Relay (Cross-Network Support) ───────────────────────────────
# Set this to your deployed Vercel URL to enable cloud relay mode.
# This allows the phone to be on a completely different network (mobile data, etc.)
# The companion will automatically connect to the cloud relay when this is set.
APP_WEB_URL=https://your-project.vercel.app

# ─── Companion Server Ports (Local Development) ─────────────────────────
COMPANION_PORT=4850
APP_WEB_PORT=3000
