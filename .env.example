# Optional: URL of your desktop companion server (defaults to http://127.0.0.1:4850)
NEXT_PUBLIC_COMPANION_URL=http://127.0.0.1:4850

# Optional: PostgreSQL connection string (only if you connect a database)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: URL of your deployed web app on Vercel for companion QR generation
# APP_WEB_URL=https://your-project.vercel.app

# Optional: Companion server ports (for local development)
COMPANION_PORT=4850
APP_WEB_PORT=3000
